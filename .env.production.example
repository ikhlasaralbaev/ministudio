# Production env for docker-compose (copy to .env.production on the server).
# MONGODB_URI is set by docker-compose (mongodb://mongo:27017).
MONGODB_DB=ministudio

# Your static https address (e.g. https://ministudio.example.uz). Telegram and Google both use it.
PUBLIC_URL=
BETTER_AUTH_URL=

# Keep the SAME APP_SECRET as before if you move existing data: bot tokens and keys are encrypted with it.
APP_SECRET=
BETTER_AUTH_SECRET=

# Google OAuth: add <PUBLIC_URL>/api/auth/callback/google to Authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SUPER_ADMIN_EMAILS=
ANTHROPIC_API_KEY=
