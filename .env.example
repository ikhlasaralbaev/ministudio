# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ministudio

# Env shifrlash va bot/owner kodlari uchun sir (kamida 16 belgi). O'zgartirsangiz, saqlangan kalitlar o'qilmay qoladi.
APP_SECRET=

# Google login (Better Auth). Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin panel / Google login manzili. Bo'sh bo'lsa PUBLIC_URL ishlatiladi.
# Lokalda bot uchun tunnel ishlatsangiz ham shu localhost qoladi.
BETTER_AUTH_URL=http://localhost:3000
# Sessiyalarni imzolash uchun tasodifiy uzun satr (masalan: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Platforma adminlari (vergul bilan). Faqat shu yerda belgilanadi.
SUPER_ADMIN_EMAILS=

# Ilovaning tashqi manzili. Telegram faqat https qabul qiladi (lokalda: ngrok http 3000).
# Google login ham shu manzilga qaytadi: lokal sinov uchun http://localhost:3000 ham bo'ladi.
PUBLIC_URL=

# AI. Kalitsiz demo rejim ishlaydi.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_MOCK=1

# Faqat ataylab kerak bo'lsa: bot ulanmagan ilovada server amallarini (dbInsert, notifyOwner, pay)
# autentifikatsiyasiz ruxsat berish. Xavfli — productionda tavsiya etilmaydi.
# ALLOW_ANONYMOUS_ACTIONS=1
